# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env/
*.egg

# Tests / linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Env & secrets
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
secrets/
**/google-sheets-sa.json
**/google*credentials*.json

# Next.js apps
apps/*/node_modules/
apps/*/.next/
apps/*/out/

# ПДн и рабочие файлы клиентов — никогда в git
storage/uploads/*
storage/processed/*
storage/knowledge_inbox/
storage/cases.json
storage/cases.tmp
!storage/uploads/.gitkeep
!storage/processed/.gitkeep
*.pdf
*.jpg
*.jpeg
*.png
!assets/**/*.png
!scripts/assets/yandex-business/promo/*.pdf
!scripts/assets/yandex-business/promo/*.png
!scripts/assets/favicon-120.png
!scripts/assets/sfrfr-logo-light.png
!tests/fixtures/sample_docs/.gitkeep
!docs/**

# Сгенерированные Word — не в git (сборка: scripts/render_landing_tz_docx.py)
*.docx
~$*.docx

# IDE / OS
.idea/
.vscode/*
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# Docker / local DB
pgdata/
# ops: обнаруженные chat_id каналов MAX (не коммитить)
var/max_channel_ids.json
var/
supabase/.branches/
supabase/.temp/

# Terraform: state/планы содержат инфраструктурные данные и могут содержать секреты
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Локальные бинарники OpenTofu / YC CLI / provider mirror (скачиваются вручную в РФ)
tools/opentofu/
tools/terraform/
tools/tf-providers/
tools/yandex-cloud/

# Local CLI logs
supabase-start.log
*.log

