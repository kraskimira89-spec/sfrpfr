APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-random-string
APP_NAME=SFRFR
# Публичный HTTPS API (поддомен на VPS): для MAX webhook
PUBLIC_BASE_URL=https://api.proverkastaza.ru
# CORS для витрины и кабинетов (через запятую)
CORS_ALLOWED_ORIGINS=https://proverkastaza.ru,https://www.proverkastaza.ru,https://cabinet.proverkastaza.ru,https://admin.proverkastaza.ru

# Supabase (основная БД + Auth + Storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Auth Send Email Hook (Яндекс-почта РФ вместо mail.app.supabase.io)
# SUPABASE_SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# Self-host YC (после cutover): прямой PG :5433 (не Supavisor :5432), sslmode=disable.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@51.250.13.240:5433/postgres?sslmode=disable
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Локальный Postgres (если без Supabase cloud)
# DATABASE_URL=postgresql+psycopg://sfrfr:sfrfr@localhost:5432/sfrfr

# dbt analytics: отдельная роль с доступом только к analytics_source и analytics.
# YC: DBT_HOST=<static-ip ВМ>, DBT_PORT=5433, DBT_SSLMODE=disable; SG allowlist.
# Legacy Cloud: db.YOUR_PROJECT.supabase.co + DBT_SSLMODE=require.
DBT_HOST=51.250.13.240
DBT_PORT=5433
DBT_USER=analytics_transformer
DBT_PASSWORD=
DBT_DBNAME=postgres
DBT_SSLMODE=disable

# Хранилище документов
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/uploads
# STORAGE_BACKEND=supabase
# SUPABASE_STORAGE_BUCKET=pension-docs

# OCR
OCR_ENGINE=tesseract
TESSERACT_LANG=rus+eng
# YANDEX_OCR_API_KEY=
# YANDEX_OCR_FOLDER_ID=

# AI — Yandex AI Studio (основной контур: DeepSeek, не YandexGPT)
AI_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Канон: DeepSeek V4 Flash в AI Studio
YANDEX_MODEL=deepseek-v4-flash
YANDEX_MODEL_CLASSIFY=deepseek-v4-flash
YANDEX_MODEL_ANALYZE=deepseek-v4-flash
YANDEX_MODEL_DRAFT=deepseek-v4-flash
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
# ТЗ-26: LLM-чат в MAX (DeepSeek)
MAX_LLM_CHAT_ENABLED=1
MAX_LLM_CHAT_MAX_TURNS=5
# MAX-first / secure action links (Sprint 1; все OFF на prod)
# docs/architecture/max-first-secure-pages.md
MAX_FIRST_FUNNEL_ENABLED=0
SECURE_ACTION_LINKS_ENABLED=0
SECURE_UPLOAD_ENABLED=0
SECURE_RESULT_VIEW_ENABLED=0
MAX_SECURE_LINK_BUTTONS_ENABLED=0
# После черновика счёта — ссылка ЮKassa + QR в MAX (нужен clients.max_user_id)
MAX_PAY_LINK_AUTO_SEND=0
# Pay-link из чата бота при готовом счёте и вопросе об оплате
CASE_CHAT_PAY_LINK_ENABLED=1
# Pepper для HMAC token_hash secure links; пусто = APP_SECRET_KEY
# SECURE_LINK_PEPPER=
# DeepSeek platform — запасной (локально: secrets/deepseek.env)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_FALLBACK_ENABLED=1
# Яндекс Метрика (отдельное OAuth-приложение, не Workspace)
# Локально: secrets/yandex-metrika.env — docs/ops/yandex-metrika-setup.md
# YANDEX_METRIKA_OAUTH_CLIENT_ID=
# YANDEX_METRIKA_OAUTH_ACCESS_TOKEN=
# YANDEX_METRIKA_COUNTER_ID=
# YANDEX_METRIKA_WEBVISOR=0
# Яндекс Workspace OAuth (ТЗ-14) — НЕ путать с YANDEX_API_KEY выше
# Локально удобнее secrets/yandex-workspace.env (gitignore)
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_FORMS_ORG_ID=
# YANDEX_FORMS_OAUTH_TOKEN=
# (forms:write; иначе ручное создание: docs/marketing-sales/playbook-yandex-form-review-prompts.md)
# YANDEX_WORKSPACE_EMAIL=proverkastaza@yandex.ru
# Отдельное приложение SFRFR_telemost (после Яндекс 360):
# YANDEX_TELEMOST_OAUTH_CLIENT_ID=
# YANDEX_TELEMOST_OAUTH_CLIENT_SECRET=
# YANDEX_TELEMOST_OAUTH_ACCESS_TOKEN=
# YANDEX_TELEMOST_ENABLED=true

# Яндекс Трекер — внутренние задачи качества (STAZH)
# TRACKER_ENABLED=true
# TRACKER_TOKEN=
# TRACKER_ORG_ID=
# TRACKER_QUEUE=STAZH
# TRACKER_CASE_REF_SECRET=
# YANDEX_MAIL_ENABLED=true
# YANDEX_MAIL_IMAP_ENABLED=false

# ТЗ-31: Postmark webhooks (Basic Auth). Резерв; канон — Yandex Cloud Postbox.
# POSTMARK_WEBHOOK_USER=
# POSTMARK_WEBHOOK_PASSWORD=
# POSTMARK_SERVER_TOKEN=
# ТЗ-31b: Mailgun HMAC / SendGrid ECDSA (сырой body)
# MAILGUN_WEBHOOK_SIGNING_KEY=
# SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# EMAIL_DELIVERY_HASH_SALT=
# Yandex Cloud Postbox (канон исходящей почты + delivery webhooks)
# YANDEX_POSTBOX_ENABLED=false
# YANDEX_POSTBOX_FROM_EMAIL=noreply@proverkastaza.ru
# YANDEX_POSTBOX_CONFIGURATION_SET=
# YANDEX_POSTBOX_ACCESS_KEY_ID=
# YANDEX_POSTBOX_SECRET_ACCESS_KEY=
# YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
# POSTBOX_WEBHOOK_USER=
# POSTBOX_WEBHOOK_PASSWORD=
# Ops: docs/ops/yandex-postbox-setup.md
# YANDEX_CALENDAR_ENABLED=true
# YANDEX_DISK_ENABLED=true
# Диск: только папка SFRFR-ops (шаблоны); ПДн-сканы → Supabase Storage
# Алиасы (если ключи лежат в LLM_* — тоже подхватятся)
# LLM_API_KEY=
# LLM_FOLDER_ID=
# LLM_MODEL=gpt://<folder>/yandexgpt-lite/latest
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# OpenAI — только для локальных экспериментов
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# MAX messenger (диалог с клиентом)
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
# ТЗ-25: служебный бот «Проверка стажа-Ops» (id8905998693_3_bot). Не публиковать на сайте.
MAX_OPS_BOT_TOKEN=
MAX_OPS_WEBHOOK_SECRET=
MAX_OPS_CHAT_URL=https://max.ru/id8905998693_3_bot
# MAX Business → раздел диалогов бота (ручной поиск по user_id оператором)
MAX_BUSINESS_DIALOGS_URL=https://business.max.ru/self
# ТЗ-27: AI-ответы специалистам (1/0). Нужен настроенный Yandex/DeepSeek LLM.
MAX_OPS_LLM_ENABLED=1
MAX_OPS_LLM_MAX_CHARS=3500
# Диалог специалистов: DeepSeek в Yandex AI Studio (не api.deepseek.com)
MAX_OPS_LLM_MODEL=deepseek-v4-flash
# Устаревшие имена MAX_BOT_SPECIALISTS_* код не читает — только MAX_OPS_* выше.
# Внутренний канал команды (не на сайт): «Проверка стажа — команда» @id8905998693_biz
MAX_SPECIALISTS_CHANNEL_URL=https://max.ru/id8905998693_biz
MAX_SPECIALISTS_CHANNEL_CHAT_ID=-77768587291288
# Диалог с ботом — единственный основной CTA сайта (без ?startapp)
MAX_CHAT_URL=https://max.ru/id8905998693_1_bot
# Deep-link на mini-app (?startapp) — открытие из бота после диагностики, не первичный CTA сайта
MAX_PUBLIC_BOT_URL=https://max.ru/id8905998693_1_bot?startapp
# HTTPS URL мини-приложения / «личного кабинета для документов»
MAX_MINIAPP_URL=https://proverkastaza.ru/app/
# Канал MAX (информирование) — не показывать как первичный CTA
MAX_CHANNEL_URL=https://max.ru/channel_proverkastaza
# chat_id канала для POST /messages (не публиковать на сайте)
MAX_CHANNEL_CHAT_ID=-77580376877720
# Форма отзыва Яндекс Бизнес (одно мягкое сообщение после completed)
YANDEX_BUSINESS_REVIEW_URL=https://proverkastaza.ru/otzyv/
# Публичный URL веб-кабинета клиента
CABINET_PUBLIC_URL=https://cabinet.proverkastaza.ru
# Кабинет сотрудников
ADMIN_PUBLIC_URL=https://admin.proverkastaza.ru
# MAX user_id руководителей (через запятую) — подтверждение входа staff
STAFF_LOGIN_APPROVER_MAX_USER_IDS=6407832
# chat_id диалога руководителя (тот же порядок)
STAFF_LOGIN_APPROVER_MAX_CHAT_IDS=321180237

# ПДн / безопасность (152-ФЗ)
PII_ENCRYPTION_KEY=
DATA_RETENTION_DAYS=90
REQUIRE_CONSENT=true

# Тарифы (метаданные продукта)
DEFAULT_DIAGNOSTIC_PRICE_RUB=3000
SUCCESS_FEE_PERCENT=10

# amoCRM API v4 — РЕЗЕРВ. Кабинет сотрудника = основная CRM (этапы + оплаты).
# Код integrations/amocrm сохранён; sync и hard-fail лида выключены.
AMOCRM_ENABLED=0
AMO_SUBDOMAIN=proverkastaza
AMO_ACCESS_TOKEN=
AMO_PIPELINE_ID=
AMO_STATUS_ID=
AMO_CASE_URL_TEMPLATE=https://{subdomain}.amocrm.ru/leads/detail/{id}

# Google Sheets (ТЗ-06): только обезличенные поля, без ФИО/телефона/СНИЛС
# 1) API (рекомендуется): service account + ID таблицы
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Analytics
# Путь к JSON ключу, например secrets/google-sheets-sa.json — или весь JSON в одну строку
GOOGLE_SHEETS_CREDENTIALS_JSON=
# 2) Fallback: Apps Script webhook
GOOGLE_SHEETS_WEBHOOK_URL=

# Google Drive (отдельный SA; расшарьте папку на client_email из JSON)
GOOGLE_DRIVE_CREDENTIALS_JSON=secrets/sfrfr-sheets-disk-bb34eeec6bd3.json
# ID корня «SFRFR — Пенсионные дела»; дерево: python -m sfrfr drive-init-tree
GOOGLE_DRIVE_FOLDER_ID=

# Google Calendar (SA; расшарьте календарь → Редактор на client_email)
GOOGLE_CALENDAR_CREDENTIALS_JSON=secrets/sfrfr-sheets-Google Calendar-ff2e34587f1b.json
# ID календаря (не primary для SA): Calendar settings → Integrate calendar
GOOGLE_CALENDAR_ID=

# Captcha: yandex (SmartCaptcha, целевой) | auto | google (legacy)
CAPTCHA_PROVIDER=yandex
# Yandex SmartCaptcha (прод)
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=
# Google reCAPTCHA Enterprise (legacy fallback, CAPTCHA_PROVIDER=google|auto)
RECAPTCHA_CREDENTIALS_JSON=secrets/sfrfr-sheets-reCAPTCHA-Enterprise-ac8f4d954b9a.json
RECAPTCHA_PROJECT_ID=sfrfr-sheets
RECAPTCHA_SITE_KEY=6Lf7UWMtAAAAANDXkb8MR9ufU8QYO9UwZsEC3NHu
RECAPTCHA_MIN_SCORE=0.5

# Yandex Wordstat MCP (Cursor) — канон: secrets/wordstat.env, см. docs/ops/yandex-wordstat-mcp.md
# YANDEX_SEARCH_API_KEY=
# YANDEX_FOLDER_ID=


# Search Console (ops): python -m sfrfr gsc-sites
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=secrets/sfrfr-sheets-Google-Search-Console-06b255b04ddd.json

# ЮKassa (чеки / redirect; в payment_methods есть и ЮMoney)
# Канон фискализации: ЮKassa → Evotor (ККТ) → Платформа ОФД (не «Чеки от ЮKassa» параллельно)
# Проверка: python -m sfrfr yookassa-status
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://cabinet.proverkastaza.ru/
# true — обязательно при fiscalization_enabled (Evotor/ОФД)
YOOKASSA_SEND_RECEIPT=true

# Публичный лид с WordPress → POST /api/public/leads (заголовок X-Public-Lead-Token)
PUBLIC_LEAD_TOKEN=
# Куда слать email о новых заявках с сайта
OPS_NOTIFY_EMAIL=proverkastaza@yandex.ru

CABINET_PUBLIC_URL=https://cabinet.proverkastaza.ru

# Эксплуатация (ТЗ-05): токен для GET /ops/status и порог алерта failed-дел
OPS_MONITOR_TOKEN=
OPS_FAILED_ALERT_THRESHOLD=1

# Первый admin кабинета сотрудников (после миграций):
#   sfrfr staff-grant --email you@company.com --role admin --invite
# Список: sfrfr staff-list
# Sheets sync: sfrfr sheets-sync
# amoCRM sync одного дела: sfrfr amocrm-sync --case-id …
# amoCRM: sfrfr amocrm-ensure-fields ; sfrfr amocrm-sync --case-id …
# Calendar: sfrfr calendar-create --case-id CASE-1 --start 2026-07-25T15:00:00+03:00
# Search Console: sfrfr gsc-sites
# Drive tree: sfrfr drive-init-tree