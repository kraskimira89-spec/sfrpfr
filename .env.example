APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-random-string
APP_NAME=SFRFR
# Публичный HTTPS API (поддомен на VPS): для MAX webhook
PUBLIC_BASE_URL=https://api.proverkastaza.ru
# CORS для витрины и кабинетов (через запятую)
CORS_ALLOWED_ORIGINS=https://proverkastaza.ru,https://www.proverkastaza.ru,https://cabinet.proverkastaza.ru,https://admin.proverkastaza.ru

# Supabase (основная БД + Auth + Storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Локальный Postgres (если без Supabase cloud)
# DATABASE_URL=postgresql+psycopg://sfrfr:sfrfr@localhost:5432/sfrfr

# dbt analytics: отдельная роль с доступом только к analytics_source и analytics.
# Для VPS используйте direct endpoint db.YOUR_PROJECT.supabase.co после IPv4 add-on.
DBT_HOST=db.YOUR_PROJECT.supabase.co
DBT_PORT=5432
DBT_USER=analytics_transformer
DBT_PASSWORD=
DBT_DBNAME=postgres

# Хранилище документов
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/uploads
# STORAGE_BACKEND=supabase
# SUPABASE_STORAGE_BUCKET=pension-docs

# OCR
OCR_ENGINE=tesseract
TESSERACT_LANG=rus+eng
# YANDEX_OCR_API_KEY=
# YANDEX_OCR_FOLDER_ID=

# AI — Yandex AI Studio (основной)
AI_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
# Алиасы (если ключи лежат в LLM_* — тоже подхватятся)
# LLM_API_KEY=
# LLM_FOLDER_ID=
# LLM_MODEL=gpt://<folder>/yandexgpt-lite/latest
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# OpenAI — только для локальных экспериментов
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# MAX messenger (диалог с клиентом)
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
# Диалог с ботом (вход в кабинет) — без ?startapp
MAX_CHAT_URL=https://max.ru/id8905998693_1_bot
# Deep-link на mini-app (?startapp) для кнопки на лендинге WP
MAX_PUBLIC_BOT_URL=https://max.ru/id8905998693_1_bot?startapp
# HTTPS URL мини-приложения (поле в кабинете MAX → Расширенные настройки)
MAX_MINIAPP_URL=https://proverkastaza.ru/app/
# Публичный URL веб-кабинета клиента
CABINET_PUBLIC_URL=https://cabinet.proverkastaza.ru
# Кабинет сотрудников
ADMIN_PUBLIC_URL=https://admin.proverkastaza.ru
# MAX user_id руководителей (через запятую) — подтверждение входа staff
STAFF_LOGIN_APPROVER_MAX_USER_IDS=6407832
# chat_id диалога руководителя (тот же порядок)
STAFF_LOGIN_APPROVER_MAX_CHAT_IDS=321180237

# ПДн / безопасность (152-ФЗ)
PII_ENCRYPTION_KEY=
DATA_RETENTION_DAYS=90
REQUIRE_CONSENT=true

# Тарифы (метаданные продукта)
DEFAULT_DIAGNOSTIC_PRICE_RUB=3000
SUCCESS_FEE_PERCENT=10
# Taganay CRM: шаблон ссылки на карточку ({id} = crm_external_id) или базовый URL
TAGANAY_CASE_URL_TEMPLATE=https://taganay.clientbase.ru/
# Исходящий webhook/API для лидов и этапов (минимум контактов, связь по case_id)
TAGANAY_WEBHOOK_URL=
TAGANAY_API_TOKEN=

# Google Sheets (ТЗ-06): только обезличенные поля, без ФИО/телефона/СНИЛС
# 1) API (рекомендуется): service account + ID таблицы
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Analytics
# Путь к JSON ключу, например secrets/google-sheets-sa.json — или весь JSON в одну строку
GOOGLE_SHEETS_CREDENTIALS_JSON=
# 2) Fallback: Apps Script webhook
GOOGLE_SHEETS_WEBHOOK_URL=

# Google Drive (отдельный SA; расшарьте папку на client_email из JSON)
GOOGLE_DRIVE_CREDENTIALS_JSON=secrets/sfrfr-sheets-disk-bb34eeec6bd3.json
# ID корня «SFRFR — Пенсионные дела»; дерево: python -m sfrfr drive-init-tree
GOOGLE_DRIVE_FOLDER_ID=

# Google Calendar (SA; расшарьте календарь → Редактор на client_email)
GOOGLE_CALENDAR_CREDENTIALS_JSON=secrets/sfrfr-sheets-Google Calendar-ff2e34587f1b.json
# ID календаря (не primary для SA): Calendar settings → Integrate calendar
GOOGLE_CALENDAR_ID=

# reCAPTCHA Enterprise (WP виджет + проверка на POST /api/public/leads)
RECAPTCHA_CREDENTIALS_JSON=secrets/sfrfr-sheets-reCAPTCHA-Enterprise-ac8f4d954b9a.json
RECAPTCHA_PROJECT_ID=sfrfr-sheets
# Публичный site key (можно в HTML). Action на витрине: lead
RECAPTCHA_SITE_KEY=6Lf7UWMtAAAAANDXkb8MR9ufU8QYO9UwZsEC3NHu
RECAPTCHA_MIN_SCORE=0.5

# Search Console (ops): python -m sfrfr gsc-sites
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=secrets/sfrfr-sheets-Google-Search-Console-06b255b04ddd.json

# ЮKassa (чеки / redirect confirmation)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=
# true — отправлять чек 54-ФЗ, если у клиента есть email
YOOKASSA_SEND_RECEIPT=false

# Публичный лид с WordPress → POST /api/public/leads (заголовок X-Public-Lead-Token)
PUBLIC_LEAD_TOKEN=

CABINET_PUBLIC_URL=https://cabinet.proverkastaza.ru

# Эксплуатация (ТЗ-05): токен для GET /ops/status и порог алерта failed-дел
OPS_MONITOR_TOKEN=
OPS_FAILED_ALERT_THRESHOLD=1

# Первый admin кабинета сотрудников (после миграций):
#   sfrfr staff-grant --email you@company.com --role admin --invite
# Список: sfrfr staff-list
# Sheets sync: sfrfr sheets-sync
# Taganay sync одного дела: sfrfr taganay-sync --case-id …
# Calendar: sfrfr calendar-create --case-id CASE-1 --start 2026-07-25T15:00:00+03:00
# Search Console: sfrfr gsc-sites
# Drive tree: sfrfr drive-init-tree