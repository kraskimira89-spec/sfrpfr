sfrfr_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_HOST') }}"
      # YC direct PG :5433 (Supavisor на :5432 — не для dbt DDL).
      port: "{{ env_var('DBT_PORT', '5433') | int }}"
      user: "{{ env_var('DBT_USER', 'analytics_transformer') }}"
      password: "{{ env_var('DBT_PASSWORD') }}"
      dbname: "{{ env_var('DBT_DBNAME', 'postgres') }}"
      schema: analytics
      threads: 4
      # Cloud: require. Self-host YC (ssl=off): disable / prefer via DBT_SSLMODE.
      sslmode: "{{ env_var('DBT_SSLMODE', 'disable') }}"
