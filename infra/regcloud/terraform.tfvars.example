# Скопируйте: copy terraform.tfvars.example terraform.tfvars
# terraform.tfvars в .gitignore — не коммитить.
#
# Токен: панель https://cloud.reg.ru/panel/ → Настройки → API-токен
# Либо: $env:TF_VAR_token = "..."  (тогда token в tfvars можно не писать)

token   = "REPLACE_WITH_REGCLOUD_API_TOKEN"
api_url = "https://api.cloudvps.reg.ru"

server_name  = "sfrfr-supabase-db-regru"
# ≥4GB для Supabase: c2-m4-d80-stdp + openstack-msk2 (base-* на msk1 → часто 500).
server_size  = "c2-m4-d80-stdp"
server_image = "ubuntu-22-04-amd64"
region_slug  = "openstack-msk2"

# Ключ уже в панели как regru_terraform_vm — не создавать заново:
manage_ssh_key      = false
ssh_key_fingerprint = "31:da:b1:9e:bf:9b:ec:79:6e:07:12:7f:fe:4b:8c:7d"
# Для нового ключа: manage_ssh_key=true и имя БЕЗ дефисов.
# ssh_key_name   = "regru_terraform_vm"
# ssh_public_key = "ssh-ed25519 AAAA... comment"

enable_backups = false
