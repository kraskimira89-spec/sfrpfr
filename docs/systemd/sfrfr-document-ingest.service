[Unit]
Description=SFRFR document ingest worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sfrfr
WorkingDirectory=/opt/sfrfr
EnvironmentFile=/opt/sfrfr/.env
ExecStart=/opt/sfrfr/.venv/bin/python /opt/sfrfr/scripts/document_ingest_worker.py
Restart=always
RestartSec=5
Nice=10
StandardOutput=append:/var/log/sfrfr/document-ingest.log
StandardError=append:/var/log/sfrfr/document-ingest.err

[Install]
WantedBy=multi-user.target
