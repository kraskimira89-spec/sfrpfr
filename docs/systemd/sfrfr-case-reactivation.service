[Unit]
Description=SFRFR case reactivation due tick (CRM + orphan MAX)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/sfrfr/.venv/bin/python

[Service]
Type=oneshot
User=sfrfr
Group=sfrfr
WorkingDirectory=/opt/sfrfr
EnvironmentFile=/opt/sfrfr/.env
Environment=CASE_REACTIVATION_AUTO_SEND=1
ExecStart=/opt/sfrfr/.venv/bin/python -m sfrfr case-reactivation-due-tick --limit 40
TimeoutStartSec=15min
Nice=10
