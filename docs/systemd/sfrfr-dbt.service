[Unit]
Description=SFRFR dbt analytics build
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/sfrfr/analytics/profiles.yml

[Service]
Type=oneshot
User=sfrfr
Group=sfrfr
WorkingDirectory=/opt/sfrfr
EnvironmentFile=/opt/sfrfr/.env
ExecStart=/bin/bash /opt/sfrfr/scripts/dbt_run.sh
TimeoutStartSec=45min
Nice=10

