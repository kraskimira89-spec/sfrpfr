[Unit]
Description=SFRFR MAX channel daily draft → ops review
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/sfrfr/.venv/bin/python

[Service]
Type=oneshot
User=sfrfr
Group=sfrfr
WorkingDirectory=/opt/sfrfr
EnvironmentFile=/opt/sfrfr/.env
ExecStart=/opt/sfrfr/.venv/bin/python -m sfrfr max-channel-daily-tick
TimeoutStartSec=5min
Nice=10
