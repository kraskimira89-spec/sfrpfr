# Self-hosted n8n (P2, некритичный glue). Не хранить ПДн клиентов.
# Канон: docs/ops/automation-stack-ru.md
# Рабочие значения — только secrets/n8n.env (в .gitignore) или /opt/sfrfr/.env.

N8N_HOST=
N8N_ENCRYPTION_KEY=
# Базовый URL webhook — только служебные сценарии (без телефонов, дел, документов)
N8N_WEBHOOK_BASE=
