# Яндекс Метрика (отдельно от Workspace / Cloud AI)
# Скопируйте в secrets/yandex-metrika.env и заполните после oauth.yandex.ru
# Инструкция: docs/ops/yandex-metrika-setup.md

YANDEX_METRIKA_OAUTH_CLIENT_ID=
YANDEX_METRIKA_OAUTH_ACCESS_TOKEN=
YANDEX_METRIKA_SITE_URL=https://proverkastaza.ru
YANDEX_METRIKA_COUNTER_NAME=Проверка стажа
YANDEX_METRIKA_COUNTER_ID=
YANDEX_METRIKA_WEBVISOR=0
# IP команды через запятую (фильтр exclude в Метрике)
YANDEX_METRIKA_EXCLUDE_IPS=
# 1 = добавить публичный IP машины, с которой запускают ensure
YANDEX_METRIKA_EXCLUDE_MY_IP=1
