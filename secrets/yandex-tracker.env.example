# Скопируйте: secrets/yandex-tracker.env (файл в .gitignore)
# OAuth app SFRFR_TRACKER — права «Трекер»; НЕ токен Workspace mail/disk.

TRACKER_OAUTH_CLIENT_ID=
TRACKER_OAUTH_CLIENT_SECRET=

# Браузер: https://oauth.yandex.ru/authorize?response_type=token&client_id=<CLIENT_ID>
# Из URL после «Разрешить» → access_token=
TRACKER_TOKEN=

# Яндекс 360 — обычно только это (не вместе с CLOUD):
TRACKER_ORG_ID=
# TRACKER_CLOUD_ORG_ID=

# Очередь качества (кабинет → Tracker MVP)
TRACKER_QUEUE=STAZH
TRACKER_CASE_REF_SECRET=
TRACKER_ENABLED=true
