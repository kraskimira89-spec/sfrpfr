# Скопировать в secrets/regcloud.env (каталог secrets/ в gitignore).
# Токен: https://cloud.reg.ru/panel/ → Настройки → API-токен для Terraform.
# Документация: docs/ops/regcloud-terraform.md
#
# Не путать с secrets/regru.env (DNS API reg.ru — другой пароль/allowlist).

REGCLOUD_API_TOKEN=
REGCLOUD_API_URL=https://api.cloudvps.reg.ru

# Для OpenTofu/Terraform:
#   $env:TF_VAR_token = $env:REGCLOUD_API_TOKEN
#   $env:TF_VAR_api_url = $env:REGCLOUD_API_URL
