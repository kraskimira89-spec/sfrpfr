# Скопируйте: secrets/supabase-selfhost-mcp.env (файл в .gitignore)
# Или: .\scripts\bootstrap_supabase_selfhost_mcp.ps1
#
# Канон: OpenSSH -L (ssh.exe) → ВМ self-host → 127.0.0.1:5433
# DBHub → 127.0.0.1:15433 (без встроенного SSH DBHub).
# AdGuard VPN: исключение C:\Windows\System32\OpenSSH\ssh.exe
#
# Прод YC (когда зона жива): SSH_HOST=51.250.69.237 SSH_USER=sfrfr
# Резерв Reg.ru (SFRFR-73):   SSH_HOST=194.67.116.168 SSH_USER=root
# Bootstrap:
#   $env:SFRFR_SUPABASE_SSH_HOST='…'; $env:SFRFR_SUPABASE_SSH_USER='…'
#   .\scripts\bootstrap_supabase_selfhost_mcp.ps1

DB_TYPE=postgres
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

SSH_HOST=51.250.69.237
SSH_USER=sfrfr
SSH_KEY=C:\Users\YOU\.ssh\id_ed25519
SSH_LOCAL_PORT=15433
SSH_REMOTE_PORT=5433
